{
  "name": "@internal-cms/shared",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": {
      "resolve": true
    },
    "splitting": true,
    "clean": true
  },
  "dependencies": {
    "class-validator": "^0.14.2",
    "tsup": "^8.5.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}
